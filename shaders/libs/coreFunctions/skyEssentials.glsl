#define CH_KNOTS 43
void getSkyChildren(float sunElevDeg, out vec3 sunC, out vec3 sunlightC, out vec3 ambientC,
                    out vec3 skyC, out vec3 horizonC, out vec3 fogC) {
    float e = clamp(sunElevDeg, CH_KNOT_E[0], CH_KNOT_E[CH_KNOTS - 1]);
    int idx = 0;
    for (int k = 1; k < CH_KNOTS - 1; k++) idx += int(e >= CH_KNOT_E[k]);
    float t = (e - CH_KNOT_E[idx]) / (CH_KNOT_E[idx + 1] - CH_KNOT_E[idx]);
    int b = idx * 6;
    sunC      = exp2(mix(CH_KNOT_V[b + 0], CH_KNOT_V[b + 6],  t));
    sunlightC = exp2(mix(CH_KNOT_V[b + 1], CH_KNOT_V[b + 7],  t));
    ambientC  = exp2(mix(CH_KNOT_V[b + 2], CH_KNOT_V[b + 8],  t));
    skyC      = exp2(mix(CH_KNOT_V[b + 3], CH_KNOT_V[b + 9],  t));
    horizonC  = exp2(mix(CH_KNOT_V[b + 4], CH_KNOT_V[b + 10], t));
    fogC      = exp2(mix(CH_KNOT_V[b + 5], CH_KNOT_V[b + 11], t));

    vec3 gradeShift = SKY_GRADE / SKY_GRADE_BASELINE;
    skyC     *= gradeShift;
    horizonC *= gradeShift;
    fogC     *= gradeShift;
    ambientC *= mix(vec3(1.0), gradeShift, SKY_AMBIENT_FOLLOW);
}